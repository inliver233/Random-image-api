# This file is loaded by `deploy/docker-compose.yml` via `env_file`.
# (Recommended) For production, copy to `deploy/.env` and point compose to it.
APP_ENV=dev

# SQLite file inside the container. Must live on the shared /app/data volume.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Worker（任务执行器）
# - docker compose 默认只启动 1 个 worker 容器；worker 进程内部会并发执行多个 job。
# - (Recommended) 默认开启“自动并发”：并发度会按启用 token 数自动增减，但会被上限限制。
WORKER_AUTO_CONCURRENCY=true
# 自动并发刷新频率（秒）：token 数变化后多久生效
WORKER_AUTO_CONCURRENCY_REFRESH_SECONDS=15
# 并发上限（无论 token 有多少都不会超过这个值）
WORKER_MAX_CONCURRENCY=50
# Optional soft SQLite write budget: caps concurrent job tasks (0 = no extra cap).
# WORKER_SQLITE_WRITE_BUDGET=0
# Job claim backend port (sqlite default | memory alias). redis/nats reserved — boot fails if set.
# JOB_QUEUE_BACKEND=sqlite

# Secrets (do NOT commit real values).
SECRET_KEY=dev-secret-key-change-me
# FIELD_ENCRYPTION_KEY is required in prod. In dev, if left blank, the app auto-generates
# a Fernet key and persists it to `./data/field_encryption_key`.
FIELD_ENCRYPTION_KEY=
# Alternatively, load it from a file (recommended for container/secret mounts):
# FIELD_ENCRYPTION_KEY_FILE=./data/field_encryption_key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-change-me

# Pixiv OAuth (required for token refresh + metadata hydrate jobs).
# In dev, if left blank, the backend defaults to Pixiv Android app constants.
PIXIV_OAUTH_CLIENT_ID=
PIXIV_OAUTH_CLIENT_SECRET=
PIXIV_OAUTH_HASH_SECRET=

# Optional build metadata
APP_VERSION=dev
APP_BUILD_TIME=
APP_COMMIT=

# Optional: imgproxy (signed URL)
# IMGPROXY_BASE_URL=http://imgproxy:8080
# IMGPROXY_KEY=
# IMGPROXY_SALT=
# IMGPROXY_MAX_DIM=2048
# IMGPROXY_DEFAULT_OPTIONS=
# IMGPROXY_URL_CHUNK_SIZE=16

# Optional: Cloudflare Worker image edge (PRIMARY public image delivery when enabled)
# Deploy: edge/img-worker
#   npx wrangler secret put IMAGE_EDGE_SECRET
#   npx wrangler deploy
# POC: sign one known path, multi-region curl status matrix, then flip enabled.
# IMAGE_EDGE_ENABLED=false
# IMAGE_EDGE_BASE_URLS=https://img.example.com
# IMAGE_EDGE_SECRET=
# Optional previous secret during rotation (Worker verifies both; backend signs only with IMAGE_EDGE_SECRET):
# IMAGE_EDGE_SECRET_PREVIOUS=
# IMAGE_EDGE_SIGN_TTL_SECONDS=604800
# Multi-base sticky pool (optional, same secret on each worker):
# IMAGE_EDGE_BASE_URLS=https://img-a.example.com,https://img-b.example.com

# Optional: Cloudflare Worker API egress pool (PRIMARY hydrate/OAuth when enabled)
# Deploy: edge/api-worker
#   npx wrangler secret put PROXY_SECRET
#   npx wrangler deploy
# When ready: OAuth refresh + /v1/illust/detail prefer CF; residential proxy is fallback.
# CF_API_PROXY_ENABLED=false
# CF_API_PROXY_BASE_URLS=https://api-edge.example.com
# Required when enabled (must match Worker PROXY_SECRET; Worker is fail-closed):
# CF_API_PROXY_SECRET=change-me
# Multi-base sticky + failover pool (same secret on each worker):
# CF_API_PROXY_BASE_URLS=https://api-a.example.com,https://api-b.example.com

# Optional: Go random-engine dual-run (default off; Python pick remains primary)
# Compose service: random-engine (host port 8091). From other containers use:
# RANDOM_ENGINE_URL=http://random-engine:8091
# From host-only BFF:
# RANDOM_ENGINE_URL=http://127.0.0.1:8091
# RANDOM_ENGINE_ENABLED=false
# RANDOM_ENGINE_TIMEOUT_MS=800
# Progressive cutover when enabled (0=never call engine, 100=all eligible picks):
# RANDOM_ENGINE_TRAFFIC_PERCENT=100
# When RANDOM_ENGINE_URL is set, API lifespan best-effort pushes a full snapshot
# (background task; never blocks boot; failures logged only). Manual:
#   POST /admin/api/maintenance/random-engine/snapshot

# Optional: R2 prewarm after catalog upserts (hydrate/import/heal; default off)
# BFF maps image_ids → pximg paths, then POSTs {paths} + X-Prewarm-Secret to
# {R2_PREWARM_URL}/v1/prewarm (img-worker; best-effort; never blocks pick path).
# Pair with edge/img-worker [[r2_buckets]] + R2_MODE=read_through|r2_only for Mode B2.
# R2_PREWARM_ENABLED=false
# R2_PREWARM_URL=https://img.example.com
# Secret for X-Prewarm-Secret (Worker accepts PREWARM_SECRET or IMAGE_EDGE_SECRET):
# R2_PREWARM_SECRET=
# (falls back to IMAGE_EDGE_SECRET when R2_PREWARM_SECRET / PREWARM_SECRET empty)
# Deploy edge: scripts/edge/deploy-img-worker.ps1
# Probe edge:  python scripts/edge/probe-img-edge.py --base-url … --secret … --twice --healthz
# Multi-region matrix (ops POC; does not flip IMAGE_EDGE_ENABLED):
#   python scripts/edge/probe-img-edge.py --bases https://a,https://b --secret … --path … --twice --healthz --out edge-matrix.json

# Optional: public API key protection (external access)
# PUBLIC_API_KEY_REQUIRED=false
# PUBLIC_API_KEY_RPM=0
# PUBLIC_API_KEY_BURST=0
# Rate-limit backend: memory (default, process-local) | redis (cross-instance).
# Redis only activates when backend=redis AND REDIS_URL is set; missing redis package
# or Redis outage fails open to process-local memory (public API stays up).
# PUBLIC_API_KEY_RATE_LIMIT_BACKEND=memory
# REDIS_URL=
# Optional alias (same as REDIS_URL if REDIS_URL empty):
# PUBLIC_API_KEY_REDIS_URL=
# Short-window anti-repeat store: memory (default, process-local) or redis (multi-instance).
# Redis activates only when backend=redis AND REDIS_URL is set; outage fails open to memory.
# RECENT_DEDUP_BACKEND=memory
